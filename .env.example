# OrderShield Runtime Environment Configuration Reference
# Note: The application does NOT automatically load .env files at startup.
# Set these variables explicitly in your shell before starting the server.

LLM_PROVIDER="qwen"
LLM_API_KEY=""

# Required when LLM_PROVIDER="qwen". Must be a workspace-specific Singapore HTTPS base:
# https://<workspace-host>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=""

DATABASE_URL="sqlite:///ordershield.db"
LIVE_INFERENCE_TIMEOUT=15.0
